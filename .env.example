# Cashu mint the register receives to. Default: Minibits.
# NEXT_PUBLIC_MINT_URL=https://mint.minibits.cash/Bitcoin

# Upstash Redis (Vercel Marketplace) for the encrypted vault. Without these the
# dev server keeps vaults in memory and production runs local-only.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
